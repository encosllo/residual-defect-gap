# Common functions for the computations of
#   L. Gong, Y. Yan and E. Cosme Llopez,
#   "Residual Subnormal Defect Two: Affine Criteria and Extremal Fitting Height".
# Load this file before the other scripts.
#
# Notation (as in the paper): H^N is the nilpotent residual of H, the last term
# of its lower central series. For L subnormal in G, Def_G(L) is the subnormal
# defect. The residual defect is b_N(G) = max { Def_G(H^N) : H subnormal in G },
# the ordinary defect is b_sn(G) = max { Def_G(H) : H subnormal in G }, and
# W(G) is the intersection of the normalizers N_G(H^N) over all subnormal H.

SizeScreen([4096, 24]);

# Nilpotent residual.
NilpotentResidual := function(H)
  local L;
  L := LowerCentralSeriesOfGroup(H);
  return L[Length(L)];
end;

# Subnormal defect of a subnormal subgroup L of G: number of steps of the
# series of successive normal closures G, L^G, L^(L^G), ... down to L.
Defect := function(G, L)
  local X, d;
  X := G; d := 0;
  while Size(X) <> Size(L) do
    X := NormalClosure(X, L);
    d := d + 1;
  od;
  return d;
end;

# Representatives of the subnormal subgroups of G up to G-conjugacy,
# obtained by iterating NormalSubgroups from G.
SubnormalReps := function(G)
  local reps, todo, S, N;
  reps := [G]; todo := [G];
  while Length(todo) > 0 do
    S := Remove(todo);
    for N in NormalSubgroups(S) do
      if not ForAny(reps, R -> Size(R) = Size(N) and IsConjugate(G, R, N)) then
        Add(reps, N); Add(todo, N);
      fi;
    od;
  od;
  return reps;
end;

# O^p(A): the subgroup generated by the p'-elements of A.
PResidual := function(A, p)
  local gens, g, o;
  gens := [];
  for g in List(ConjugacyClasses(A), Representative) do
    o := Order(g);
    while o mod p = 0 do o := o / p; od;
    Add(gens, g^(Order(g) / o));
  od;
  return NormalClosure(A, Subgroup(A, gens));
end;

# Tested residuals, b_N(G) and W(G), computed through G/F(G): by
# [Part I, Lemma 2.2], (F(G)H)^N = H^N for H subnormal in G, so the tested
# residuals are the residuals of the full inverse images of the subnormal
# subgroups of G/F(G). W(G) is the intersection of the cores of the
# normalizers, which accounts for all conjugates.
ResidualData := function(G)
  local F, hom, reps, A, R, d, bN, W;
  F := FittingSubgroup(G);
  hom := NaturalHomomorphismByNormalSubgroup(G, F);
  reps := SubnormalReps(Image(hom));
  bN := 0; W := G;
  for A in reps do
    R := NilpotentResidual(PreImage(hom, A));
    d := Defect(G, R);
    if d > bN then bN := d; fi;
    W := Intersection(W, Core(G, Normalizer(G, R)));
  od;
  return rec(bN := bN, W := W, nreps := Length(reps));
end;

# The same data by brute force over all subnormal subgroups of G (up to
# conjugacy), without the Fitting shortcut. Also returns b_sn(G).
ResidualDataBrute := function(G)
  local reps, H, R, d, bN, bsn, W;
  reps := SubnormalReps(G);
  bN := 0; bsn := 0; W := G;
  for H in reps do
    R := NilpotentResidual(H);
    d := Defect(G, R);
    if d > bN then bN := d; fi;
    d := Defect(G, H);
    if d > bsn then bsn := d; fi;
    W := Intersection(W, Core(G, Normalizer(G, R)));
  od;
  return rec(bN := bN, bsn := bsn, W := W, nreps := Length(reps));
end;

# Length of the upper W-series.
UpperWLength := function(G)
  local n, Q, W;
  n := 0; Q := G;
  while Size(Q) > 1 do
    W := ResidualData(Q).W;
    Q := Q / W;
    n := n + 1;
  od;
  return n;
end;

# Fitting height.
FittingHeight := function(G)
  local h, Q;
  h := 0; Q := G;
  while Size(Q) > 1 do
    Q := Q / FittingSubgroup(Q);
    h := h + 1;
  od;
  return h;
end;

# The affine group V x| M for a soluble matrix group M over GF(p), built as
# a pc group with SplitExtension. Returns the group G, its subgroups V and M
# (the complement), and the isomorphism iso from the matrix group onto M.
AffinePcGroup := function(Mmat, p)
  local n, pciso, Mpc, pcg, mats, G, pp, k, comp, iso;
  n := DimensionOfMatrixGroup(Mmat);
  pciso := IsomorphismPcGroup(Mmat);
  Mpc := Image(pciso);
  pcg := Pcgs(Mpc);
  mats := List(pcg, g -> PreImagesRepresentative(pciso, g));
  G := SplitExtension(Mpc, GModuleByMats(mats, GF(p)));
  pp := Pcgs(G); k := Length(pcg);
  comp := Subgroup(G, pp{[1..k]});
  iso := GroupHomomorphismByImages(Mpc, comp, AsList(pcg), pp{[1..k]});
  return rec(G := G,
             V := Subgroup(G, pp{[k+1..k+n]}),
             M := comp,
             iso := CompositionMapping(iso, pciso));
end;

# Permutation matrices of a permutation group S over GF(p).
PermutationMatrices := function(S, p)
  return Group(List(GeneratorsOfGroup(S),
                    g -> PermutationMat(g, LargestMovedPoint(S), GF(p))));
end;

# Regular permutation representation of a group.
RegularPermGroup := S -> Action(S, AsList(S), OnRight);
